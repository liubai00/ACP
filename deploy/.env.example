# ACP 部署配置。install.sh 会复制成 .env 并自动填好所有 <random> 项。
# 修改后在 deploy/ 目录执行：docker compose up -d（改了 FEISHU_* / GITLAB_* 等也是这条命令）

# ---------------------------------------------------------------- 访问地址
# 只有 IP（先跑起来）：
ACP_PUBLIC_URL=http://<server-ip>
N8N_PUBLIC_URL=http://<server-ip>:5678
ACP_SITE_ADDRESS=:80
N8N_SITE_ADDRESS=:5678
N8N_HOST=<server-ip>
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
# 有域名后改成（Caddy 自动申请证书，需放行 80/443）：
# ACP_PUBLIC_URL=https://acp.example.com
# N8N_PUBLIC_URL=https://n8n.acp.example.com
# ACP_SITE_ADDRESS=acp.example.com
# N8N_SITE_ADDRESS=n8n.acp.example.com
# N8N_HOST=n8n.acp.example.com
# N8N_PROTOCOL=https
# N8N_SECURE_COOKIE=true
ACME_EMAIL=admin@example.com

# 宿主机端口（一般不用改）
ACP_HTTP_PORT=80
ACP_HTTPS_PORT=443
N8N_EXPOSE_PORT=5678

# ---------------------------------------------------------------- 引导管理员（飞书登录配好前用它登录任务榜）
ACP_ADMIN_USERNAME=admin
ACP_ADMIN_PASSWORD=<random>

# ---------------------------------------------------------------- 内部密钥（自动生成，别外传）
POSTGRES_PASSWORD=<random>
N8N_DB_PASSWORD=<random>
N8N_ENCRYPTION_KEY=<random>
ACP_CONNECTOR_TOKEN=<random>
ACP_NOTIFY_TOKEN=<random>
BRIDGE_FORWARD_TOKEN=<random>
GITLAB_WEBHOOK_TOKEN=<random>
AGW_SESSION_KEY=<random32>

# ---------------------------------------------------------------- 飞书（自建应用，见 ACP-DOC-002 第 9 节）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
# 受理的群 chat_id，逗号分隔；留空 = 机器人所在的群都受理
FEISHU_CHAT_IDS=
# 进单方式：at_mention（@机器人）、shortcut（消息快捷操作）、all（读全部群消息，需敏感权限）
FEISHU_INTAKE_MODE=at_mention,shortcut
# 消息快捷操作等额外事件类型（以飞书控制台显示为准），逗号分隔
BRIDGE_EXTRA_EVENTS=
# n8n 不可用时可改为直连：http://coordinator:8000/api/hooks/feishu-bridge
BRIDGE_FORWARD_URL=http://n8n:5678/webhook/feishu-events

# ---------------------------------------------------------------- GitLab（见 ACP-DOC-002 第 10 节）
GITLAB_URL=
GITLAB_BOT_TOKEN=

# ---------------------------------------------------------------- 通知出口：n8n（默认）| direct（协调服务器直接调飞书/GitLab）| log（只记录）
ACP_NOTIFY_MODE=n8n
# n8n 里 Settings → n8n API 创建的 Key，填上后任务榜“自动化流程”页能显示工作流与执行记录
N8N_API_KEY=

# ---------------------------------------------------------------- 协调 Agent（大模型）
ACP_LLM_ENABLED=false
# 网关里的提供商：openAI | anthropic；模型名按提供商填写
LLM_PROVIDER=openAI
# 自定义 HTTPS 提供商主机名（不含协议、端口和 /v1）；留空使用提供商默认地址
LLM_UPSTREAM_HOST=
ACP_LLM_MODEL=
# 对支持推理的模型显式指定，例如 xhigh；留空使用已有的普通聊天参数
ACP_LLM_REASONING_EFFORT=
# key 只给 agentgateway，协调服务器经网关 3001 端口调用
LLM_API_KEY=
ACP_AGENT_LEVEL_DEFAULT=L0

# ---------------------------------------------------------------- 其他
TZ=Asia/Shanghai
ACP_SEED_DEMO=false
ACP_LOG_LEVEL=info
# 国内服务器拉 PyPI 慢时可换镜像，例如 https://mirrors.cloud.tencent.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
ACP_VERSION=local
N8N_VERSION=1.123.1
AGENTGATEWAY_VERSION=v1.7.0
